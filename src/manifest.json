{
  "manifest_version": 3,
  "name": "GitHub Pixel Diff",
  "version": "0.1.1",
  "description": "Добавляет в просмотр картинок на GitHub режим попиксельной разницы — рядом с 2-up, Swipe и Onion Skin.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://viewscreen.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://viewscreen.githubusercontent.com/diff/img*"
      ],
      "js": [
        "vendor/pixelmatch.js",
        "content/compare.js",
        "content/frame.js"
      ],
      "css": [
        "content/frame.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "GitHub Pixel Diff",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}

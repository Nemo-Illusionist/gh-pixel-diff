{
  "manifest_version": 3,
  "name": "GitHub Pixel Diff",
  "version": "0.1.0",
  "description": "Показывает попиксельную разницу изображений прямо в diff'е пул-реквеста на GitHub.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["vendor/pixelmatch.js", "content/compare.js", "content/ui.js", "content/main.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://viewscreen.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://viewscreen.githubusercontent.com/diff/img*"
      ],
      "js": [
        "vendor/pixelmatch.js",
        "content/i18n.js",
        "content/compare.js",
        "content/frame.js"
      ],
      "css": [
        "content/frame.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pixelmatch.js",
        "content/compare.js",
        "content/worker.js"
      ],
      "matches": [
        "https://viewscreen.githubusercontent.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  }
}
